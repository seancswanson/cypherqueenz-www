---
import Emoji from "astro-emoji";
import { Image } from "astro:assets";
import logo from "../images/shared/logo.webp";
---

<section class="flex flex-col px-4 py-24">
  <h2 class="text-center text-xl font-bold lowercase sm:text-2xl mb-2">
    Want to stay up to date on all things CypherQueenz?
  </h2>
  <div class="flex flex-col items-center justify-center gap-4">
    <div class="flex flex-col gap-4 text-center">
      <p class="text-xl sm:text-2xl">
        Follow us on <a
          href="https://www.instagram.com/cypherqueenz/?hl=en"
          class="w-max border-b-4 border-[#FACC15]"
          ><Emoji symbol="🔗" /> instagram</a
        > and <a
          href="https://www.facebook.com/cypherqueenz"
          class="w-max border-b-4 border-[#FACC15]"
          ><Emoji symbol="🔗" /> facebook</a
        >.
      </p>
      <p class="sm:text-xl">
        For all other inquiries don't hesitate to <a
          href="mailto:cypherqueenz206@gmail.com"
          class="w-max border-b-4 border-[#FACC15]"
          ><Emoji symbol="📧" /> reach out to us.</a
        >
      </p>
    </div>
  </div>
</section>

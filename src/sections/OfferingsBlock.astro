---
import { Image } from "astro:assets";
import groupPicture from "../images/home/cypher-queenz-group-outline-transparent.webp";
---

<section class="flex flex-col gap-8 md:p-8 md:flex-row rounded z-20 mb-10">
  <div class="flex basis-1/2 flex-col gap-8 justify-start">
    <h2 class="text-xl font-bold lowercase sm:text-2xl bg-[rgba(255,255,255,0.9)] w-max">What we do</h2>
    <p class="sm:text-xl bg-[rgba(255,255,255,0.9)]">
      We offer <b>free monthly workshops/cypher sessions</b> and <b
        >supportive community</b
      > for experience dancers and those just getting started <b
        >from day one.</b
      >
    </p>
    <a href="/about" class="flex flex-row gap-4 text-lg md:text-xl">
      <span class="border-b-4 border-[#facc15]">
        Read more about our mission, vision, and values</span
      >
      →
    </a>
  </div>
  <div class="basis-1/2">
    <Image
      src={groupPicture}
      class="object-contain object-center w-full h-full"
      alt="group photo"
    />
  </div>
</section>


---
import heroPoster from "../images/home/hero-poster.webp";
import heroVideo from "../video/cypher-queenz-video-compressed.mp4";
---

<section class="flex flex-col p-2 sm:p-8 lg:flex-row gap-12 mb-10">
  <div class="md:basis-1/3 lg:basis-1/2">
    <video
      autoplay
      playsinline
      muted
      loop
      poster={heroPoster.src}
      id="myVideo"
      class="object-cover object-center w-full h-full shadow"
    >
      <source src={heroVideo} type="video/mp4" />
    </video>
  </div>
  <div class="flex flex-col flex-1 gap-8 justify-center">
    <h1 class="text-2xl font-extrabold lowercase bottom sm:text-3xl bg-white w-fit z-20">
      Who we are
    </h1>
    <p class="text-xl sm:text-2xl bg-white">
      A Bgirl collective coming together to grow and leveling up the scene by
      highlighting women voices in Hip Hop
    </p>

    <div class="flex flex-col gap-4 text-[19px] font-thin tracking-tighter md:flex-row">
      <a
        href="/about"
        aria-label="Learn more about CYPHERQueenz"
        class="flex items-center w-max bg-[#800000] justify-center px-8 text-white rounded-full hover:scale-105 transition-all duration-300" 
        >learn about us</a
      >
      <a
        href="/connect#support"
               class="flex items-center px-8 justify-center rounded-full border-2 text-black  border-[#800000] hover:scale-105 hover:bg-[#800000] hover:text-white transition-all duration-300 bg-white"
        >support @cypherqueenz</a>
    </div>
  </div>
</section>

<style>
  .screen-reader-text {
    border: 0;
    clip: rect(1px, 1px, 1px, 1px);
    -webkit-clip-path: inset(50%);
    clip-path: inset(50%);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute !important;
    width: 1px;
    word-wrap: normal !important;
    word-break: normal;
}
</style>
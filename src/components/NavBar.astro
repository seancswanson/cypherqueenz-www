---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/events", label: "Events" },
  { href: "/media", label: "Media" },
  { href: "/connect", label: "Connect With Us" },
];

// Events submenu items
const eventsSubMenu = [
  { href: "/events#upcoming", label: "Upcoming Events" },
  { href: "/events#past", label: "Past Events" },
];
---

<header class="sticky-top bg-[#800000] text-white">
  <nav
    class="mx-auto flex max-w-[1440px] flex-wrap items-stretch justify-between "
  >
    <div
      class="relative flex min-h-[60px] w-full items-center justify-between lg:w-auto"
    >
      <a
        href="/"
        class="pl-2 text-4xl font-bold tracking-tighter w-max md:text-5xl"
        >CYPHER<span class="font-[100]">Queenz</span></a
      >

      <button
        id="hamburger"
        class="ml-auto mr-2 self-center p-2 transition-colors hover:bg-[#facc15] lg:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>

    <div
      id="navMenuContainer"
      class="hidden w-full lowercase lg:mt-0 lg:flex lg:w-auto lg:items-stretch"
    >
      <ul class="flex flex-col w-full lg:w-auto lg:flex-row">
        {
          navItems.map((item) => (
            <li
              class={`nav-item flex items-stretch ${item.label === "Events" ? "flex-col lg:flex-row lg:relative events-dropdown-wrapper" : ""}`}
            >
              <a
                href={item.href}
                class={`flex w-full items-center border-b-4 px-4 py-2 text-xl font-[100] hover:border-[#facc15] lg:py-0 ${
                  currentPath === item.href
                    ? "border-b-4 border-[#facc15]"
                    : "border-transparent"
                }`}
                id={item.label === "Events" ? "eventsLink" : ""}
              >
                {item.label}
                {item.label === "Events" && (
                  <svg 
                    class="w-4 h-4 ml-1" 
                    fill="none" 
                    stroke="currentColor" 
                    viewBox="0 0 24 24" 
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      stroke-width="2" 
                      d="M19 9l-7 7-7-7"
                    ></path>
                  </svg>
                )}
              </a>
              
              {item.label === "Events" && (
                <div 
                  id="eventsDropdown"
                  class="hidden overflow-hidden lg:absolute lg:top-full lg:left-0 lg:mt-0 lg:w-48 lg:bg-white lg:shadow-lg lg:rounded-md lg:z-10 w-full"
                >
                  <ul class="lg:text-gray-800 text-white overflow-hidden">
                    {eventsSubMenu.map((subItem) => (
                      <li>
                        <a
                          href={subItem.href}
                          class="block px-4 py-2 hover:bg-[#facc15] hover:text-gray-900 lg:text-gray-800 pl-8 lg:pl-4"
                        >
                          {subItem.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  @media (max-width: 1023px) {
    #navMenuContainer {
      border-top: 2px solid #800000;
    }

    .nav-item:last-child {
      border-bottom: none;
    }
    
    #eventsDropdown {
      background-color: #800000;
    }
  }
  
  /* Desktop dropdown hover functionality */
  @media (min-width: 1024px) {
    .events-dropdown-wrapper:hover #eventsDropdown {
      display: block;
    }
  }
</style>

<script is:inline data-astro-rerun>
  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', function() {
    // Get elements
    const hamburger = document.getElementById('hamburger');
    const navMenuContainer = document.getElementById('navMenuContainer');
    const eventsLink = document.getElementById('eventsLink');
    const eventsDropdown = document.getElementById('eventsDropdown');
    
    // Toggle hamburger menu
    if (hamburger && navMenuContainer) {
      hamburger.addEventListener('click', function() {
        navMenuContainer.classList.toggle('hidden');
      });
    }
    
    // Toggle events dropdown
    if (eventsLink && eventsDropdown) {
      eventsLink.addEventListener('click', function(e) {
        // Only prevent default on mobile
        if (window.innerWidth < 1024) {
          e.preventDefault();
          eventsDropdown.classList.toggle('hidden');
        }
      });
      
      // Close dropdown when clicking elsewhere
      document.addEventListener('click', function(e) {
        const target = e.target;
        if (eventsLink && eventsDropdown && 
            !eventsLink.contains(target) && 
            !eventsDropdown.contains(target)) {
          if (window.innerWidth < 1024 && !eventsDropdown.classList.contains('hidden')) {
            eventsDropdown.classList.add('hidden');
          }
        }
      });
      
      // Close dropdown when clicking on a submenu item
      const submenuLinks = eventsDropdown.querySelectorAll('a');
      submenuLinks.forEach(function(link) {
        link.addEventListener('click', function() {
          if (window.innerWidth < 1024) {
            eventsDropdown.classList.add('hidden');
            if (navMenuContainer) {
              navMenuContainer.classList.add('hidden');
            }
          }
        });
      });
    }
  });
</script>